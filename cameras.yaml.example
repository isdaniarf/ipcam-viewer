server:
  listen: ":80"
  username: viewer
  password: choose_a_viewer_password

cameras:
  - name: hallway
    host: 192.168.1.54
    username: your_camera_account
    password: your_camera_password
    rtsp:
      port: 554
      path: /stream1
      sub_path: /stream2
    onvif:
      port: 2020

  - name: living_room_1
    label: Living Room
    host: 192.168.1.55
    username: your_camera_account
    password: your_camera_password
    rtsp:
      port: 554
      path: /stream1
      sub_path: /stream2

  - name: house_front
    host: 192.168.1.56
    username: your_camera_account
    password: your_camera_password
    rtsp:
      port: 554
      path: /stream1
      sub_path: /stream2
    tapo:
      username: your_tplink_account_email
      password: your_tplink_cloud_password
