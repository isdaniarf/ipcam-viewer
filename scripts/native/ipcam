#!/bin/sh
set -eu

LABEL="io.ipcam-viewer.go2rtc"
UNIT_NAME="ipcam-viewer"
BIN_DIR="${IPCAM_BIN_DIR:-$HOME/.local/bin}"
LINK_PATH="$BIN_DIR/ipcam"

resolve_self() {
  target=$1
  case $target in
    /*) ;;
    *) target=$(pwd)/$target ;;
  esac
  while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
      /*) target=$link ;;
      *) target=$(cd "$(dirname "$target")" && pwd)/$link ;;
    esac
  done
  printf '%s\n' "$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
}

SELF=$(resolve_self "$0")
BUNDLE_DIR=$(cd "$(dirname "$SELF")" && pwd)
CONFIG="$BUNDLE_DIR/go2rtc.yaml"
LOG="$BUNDLE_DIR/go2rtc.log"

case "$(uname -s)" in
  Darwin) OS=macos ;;
  Linux) OS=linux ;;
  *) echo "ipcam: unsupported system $(uname -s)" >&2; exit 1 ;;
esac

die() { echo "ipcam: $1" >&2; exit 1; }

yaml_value() {
  sed -n "/^api:/,/^[a-z]/p" "$CONFIG" | sed -n "s/^  $1: *//p" | head -1 | tr -d '"'"'"
}

listen_address() { yaml_value listen; }
viewer_user() { v=$(yaml_value username); [ -n "$v" ] && printf '%s\n' "$v" || printf 'viewer\n'; }

listen_port() {
  address=$(listen_address)
  port=${address##*:}
  [ -n "$port" ] && printf '%s\n' "$port" || printf '80\n'
}

lan_address() {
  if [ "$OS" = macos ]; then
    for interface in en0 en1 en2; do
      address=$(ipconfig getifaddr "$interface" 2>/dev/null) || continue
      [ -n "$address" ] && { printf '%s\n' "$address"; return; }
    done
  else
    address=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -n "$address" ] && { printf '%s\n' "$address"; return; }
  fi
  printf 'localhost\n'
}

base_url() {
  port=$(listen_port)
  host=$(lan_address)
  if [ "$port" = 80 ]; then printf 'http://%s/\n' "$host"; else printf 'http://%s:%s/\n' "$host" "$port"; fi
}

http_code() {
  code=$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$(listen_port)/" 2>/dev/null) || true
  case ${code:-} in
    "" | 000) printf '000\n' ;;
    *) printf '%s\n' "$code" ;;
  esac
}

allow_unsigned_binary() {
  [ "$OS" = macos ] || return 0
  xattr -d com.apple.quarantine "$BUNDLE_DIR/go2rtc" 2>/dev/null || true
  xattr -d com.apple.quarantine "$SELF" 2>/dev/null || true
}

require_bundle() {
  [ -x "$BUNDLE_DIR/go2rtc" ] || die "no go2rtc binary in $BUNDLE_DIR"
  if [ ! -f "$CONFIG" ] && [ -f "$BUNDLE_DIR/cameras.ini" ]; then render_config; fi
  [ -f "$CONFIG" ] || die "no config in $BUNDLE_DIR. Run: ipcam discover, or: ipcam config import cameras.ini"
}

render() {
  sed -e "s#{{BUNDLE_DIR}}#$BUNDLE_DIR#g" -e "s#{{LABEL}}#$LABEL#g" -e "s#{{USER}}#$(id -un)#g" "$1"
}

# A LaunchDaemon, not a LaunchAgent, and it runs as root. macOS Local Network
# privacy blocks every LAN connection of a process that runs as a normal user
# from launchd, so an agent reaches no camera. root is exempt. See CLAUDE.md.
plist_path() { printf '/Library/LaunchDaemons/%s.plist\n' "$LABEL"; }
domain() { printf 'system\n'; }

# `launchctl bootstrap system` fails with "Load failed: 5: Input/output error"
# when it runs from a user's terminal. The legacy loader still works.
load_macos() {
  sudo launchctl bootstrap system "$(plist_path)" 2>/dev/null ||
    sudo launchctl load -w "$(plist_path)"
}

start_macos() {
  [ -f "$(plist_path)" ] || die "the service is not installed. Run: ipcam install"
  load_macos
}
stop_macos() {
  sudo launchctl bootout "system/$LABEL" 2>/dev/null ||
    sudo launchctl unload "$(plist_path)" 2>/dev/null || true
}

install_macos() {
  tmp=$(mktemp) || die "could not write a temporary file"
  render "$BUNDLE_DIR/service/launchd.plist" > "$tmp"
  stop_macos
  sudo install -o root -g wheel -m 644 "$tmp" "$(plist_path)"
  rm -f "$tmp"
  load_macos
}

uninstall_macos() { stop_macos; sudo rm -f "$(plist_path)"; }

state_macos() {
  info=$(launchctl print "$(domain)/$LABEL" 2>/dev/null) || {
    if [ -f "$(plist_path)" ]; then printf 'installed, stopped\n'; else printf 'not installed\n'; fi
    return
  }
  state=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*state = //p' | head -1)
  pid=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*pid = //p' | head -1)
  printf '%s%s\n' "${state:-unknown}" "${pid:+ (pid $pid)}"
}

# root owns the log, because the daemon runs as root.
logs_macos() {
  [ -f "$LOG" ] || die "no log file at $LOG"
  if [ -r "$LOG" ]; then tail -n 50 -f "$LOG"; else sudo tail -n 50 -f "$LOG"; fi
}

unit_path() { printf '/etc/systemd/system/%s.service\n' "$UNIT_NAME"; }
start_linux() { sudo systemctl start "$UNIT_NAME"; }
stop_linux() { sudo systemctl stop "$UNIT_NAME" 2>/dev/null || true; }

install_linux() {
  render "$BUNDLE_DIR/service/systemd.service" | sudo tee "$(unit_path)" >/dev/null
  sudo systemctl daemon-reload
  sudo systemctl enable --now "$UNIT_NAME"
}

uninstall_linux() {
  sudo systemctl disable --now "$UNIT_NAME" 2>/dev/null || true
  sudo rm -f "$(unit_path)"
  sudo systemctl daemon-reload
}

state_linux() {
  systemctl is-active "$UNIT_NAME" 2>/dev/null | head -1 || printf 'not installed\n'
}

logs_linux() { journalctl -u "$UNIT_NAME" -n 50 -f; }

wait_for_http() {
  attempt=0
  while [ "$attempt" -lt 20 ]; do
    code=$(http_code)
    case $code in 000) ;; *) printf '%s\n' "$code"; return 0 ;; esac
    attempt=$((attempt + 1))
    sleep 0.25
  done
  printf '000\n'
  return 1
}

report_start_failure() {
  echo ""
  echo "The service did not answer on port $(listen_port)." >&2
  if [ -f "$LOG" ]; then
    echo "Last log lines:" >&2
    tail -5 "$LOG" >&2
  fi
  echo "" >&2
  echo "A port below 1024 can need root on some systems." >&2
  echo "Set a high port in cameras.ini under [server], for example listen = :8080," >&2
  echo "then run: ipcam update" >&2
}

do_link() {
  mkdir -p "$BIN_DIR"
  ln -sf "$SELF" "$LINK_PATH"
  echo "Linked $LINK_PATH"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) echo "Note: $BIN_DIR is not in PATH. Add it in your shell profile." ;;
  esac
}

do_unlink() {
  if [ -L "$LINK_PATH" ] && [ "$(resolve_self "$LINK_PATH")" = "$SELF" ]; then
    rm -f "$LINK_PATH"; echo "Removed $LINK_PATH"
  else
    echo "No link of this bundle at $LINK_PATH"
  fi
}

build_info() {
  [ -f "$BUNDLE_DIR/build-info" ] || return 1
  value=$(sed -n "s/^$1=//p" "$BUNDLE_DIR/build-info" | head -1)
  [ -n "$value" ] || return 1
  printf '%s\n' "$value"
}

cmd_install() {
  link=yes
  for argument in "$@"; do
    case $argument in
      --no-link) link=no ;;
      *) die "unknown option $argument" ;;
    esac
  done
  require_bundle
  allow_unsigned_binary
  "install_$OS"
  [ "$link" = yes ] && do_link || true
  if code=$(wait_for_http); then
    echo "Service running. HTTP $code"
    cmd_url
  else
    report_start_failure
    exit 1
  fi
}

cmd_uninstall() { "uninstall_$OS"; do_unlink; echo "Service removed."; }

cmd_start() {
  require_bundle; allow_unsigned_binary; "start_$OS"
  if code=$(wait_for_http); then echo "Service running. HTTP $code"; else report_start_failure; exit 1; fi
}

cmd_stop() { "stop_$OS"; echo "Service stopped."; }

cmd_restart() {
  require_bundle; allow_unsigned_binary; "stop_$OS"; "start_$OS"
  if code=$(wait_for_http); then echo "Service running. HTTP $code"; else report_start_failure; exit 1; fi
}

cmd_status() {
  echo "Bundle:  $BUNDLE_DIR"
  echo "Service: $("state_$OS")"
  code=$(http_code)
  case $code in
    000) echo "HTTP:    no answer on port $(listen_port)" ;;
    *) echo "HTTP:    $code on port $(listen_port)" ;;
  esac
  echo "URL:     $(base_url)"
  echo "User:    $(viewer_user)"
  if [ -L "$LINK_PATH" ]; then echo "Command: $LINK_PATH"; else echo "Command: not linked. Run: ipcam link"; fi
}

cmd_url() { echo "Open $(base_url) and log in as $(viewer_user)"; }

cmd_update() {
  build=no
  for argument in "$@"; do
    case $argument in
      --build) build=yes ;;
      *) die "unknown option $argument" ;;
    esac
  done
  repo=$(build_info repo) || repo=""

  if [ "$build" = yes ]; then
    [ -n "$repo" ] && [ -d "$repo" ] || die "--build needs the repository that built this bundle."
    command -v node >/dev/null 2>&1 || die "node is not installed"
    node "$repo/scripts/bundle.mjs" --out "$BUNDLE_DIR"
  else
    render_config
    echo "Config regenerated from $BUNDLE_DIR/cameras.ini"
    if [ -n "$repo" ] && [ -f "$repo/cameras.ini" ] &&
       ! cmp -s "$repo/cameras.ini" "$BUNDLE_DIR/cameras.ini"; then
      echo "note: $repo/cameras.ini differs from the one above, and was not used."
      echo "      Run 'ipcam update --build' to take the repository's copy instead."
    fi
  fi

  if service_is_this_bundle; then
    cmd_restart
  else
    echo "Next: ipcam install"
  fi
}

config_files() {
  files="go2rtc.yaml cameras.json"
  [ -f "$BUNDLE_DIR/cameras.ini" ] && files="$files cameras.ini"
  printf '%s\n' "$files"
}


cmd_config() {
  action=${1:-show}
  [ $# -gt 0 ] && shift || true
  case $action in
    export)
      target=${1:-$(pwd)/ipcam-config.tgz}
      case $target in /*) ;; *) target=$(pwd)/$target ;; esac
      [ -f "$CONFIG" ] || die "no go2rtc.yaml in $BUNDLE_DIR"
      # shellcheck disable=SC2046
      ( cd "$BUNDLE_DIR" && tar -czf "$target" $(config_files) )
      echo "Wrote $target"
      echo "It holds the camera passwords and the viewer password. Send it over a private channel."
      ;;
    import|"")
      source=${1:-}
      [ -n "$source" ] || die "usage: ipcam config import <file.tgz|cameras.ini|go2rtc.yaml|url>"
      scratch=$(mktemp -d)
      original=$source
      case $source in
        http://*|https://*)
          curl -fsSL "$source" -o "$scratch/download" || { rm -rf "$scratch"; die "could not download $source"; }
          source=$scratch/download
          ;;
        *) [ -f "$source" ] || { rm -rf "$scratch"; die "no such file: $source"; } ;;
      esac

      if tar -tzf "$source" >/dev/null 2>&1; then
        tar -xzf "$source" -C "$scratch"
        if [ -f "$scratch/cameras.ini" ]; then
          cp "$scratch/cameras.ini" "$BUNDLE_DIR/cameras.ini"
          rm -rf "$scratch"
          render_config
        else
          [ -f "$scratch/go2rtc.yaml" ] || { rm -rf "$scratch"; die "$original holds no config"; }
          cp "$scratch/go2rtc.yaml" "$BUNDLE_DIR/go2rtc.yaml"
          if [ -f "$scratch/cameras.json" ]; then
            cp "$scratch/cameras.json" "$BUNDLE_DIR/cameras.json"
            if [ -d "$BUNDLE_DIR/www" ]; then cp "$scratch/cameras.json" "$BUNDLE_DIR/www/cameras.json"; fi
          fi
          rm -rf "$scratch"
        fi
      elif grep -qE '^[[:space:]]*\[[^]]+\][[:space:]]*$' "$source" 2>/dev/null; then
        cp "$source" "$BUNDLE_DIR/cameras.ini"
        rm -rf "$scratch"
        render_config
      elif grep -q "^api:" "$source" 2>/dev/null; then
        cp "$source" "$BUNDLE_DIR/go2rtc.yaml"
        rm -rf "$scratch"
        [ -f "$BUNDLE_DIR/cameras.json" ] || echo "note: no cameras.json came with it. The page will list no camera until one arrives."
      elif grep -qE '^(cameras|server):[[:space:]]*$' "$source" 2>/dev/null; then
        rm -rf "$scratch"
        die "$original is in the old YAML format. The config is INI now: one [section] per camera. See cameras.ini.example."
      else
        rm -rf "$scratch"
        die "$original is neither a config archive, a cameras.ini, nor a go2rtc.yaml"
      fi

      echo "Config installed in $BUNDLE_DIR"
      if service_is_this_bundle; then
        "$SELF" restart
      else
        echo "Next: ipcam install"
      fi
      ;;
    show)
      echo "Config:  $CONFIG"
      if [ -f "$BUNDLE_DIR/cameras.ini" ]; then echo "Source:  $BUNDLE_DIR/cameras.ini"; fi
      echo "Listen:  $(listen_address)"
      echo "User:    $(viewer_user)"
      echo "Cameras: $(sed -n 's/.*"name": "\([^"]*\)".*/\1/p' "$BUNDLE_DIR/cameras.json" 2>/dev/null | tr '\n' ' ')"
      ;;
    *) die "unknown config action \"$action\". Use export, import or show." ;;
  esac
}

urlencode() {
  string=$1
  out=""
  while [ -n "$string" ]; do
    char=${string%"${string#?}"}
    case $char in
      [a-zA-Z0-9.~_-]) out="$out$char" ;;
      *) out="$out$(printf '%%%02X' "'$char")" ;;
    esac
    string=${string#?}
  done
  printf '%s' "$out"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//' | cut -c1-40
}

json_field() {
  printf '%s' "$2" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"
}

json_objects() {
  printf '%s' "$1" | sed 's/},{/}\
{/g' | sed 's/^{"sources":\[//; s/\]}$//'
}

random_secret() {
  od -An -tx1 -N12 /dev/urandom | tr -d ' \n'
}


service_is_this_bundle() {
  if [ "$OS" = macos ]; then
    [ -f "$(plist_path)" ] || return 1
    grep -q "$BUNDLE_DIR/go2rtc" "$(plist_path)" 2>/dev/null
  else
    [ -f "$(unit_path)" ] || return 1
    grep -q "$BUNDLE_DIR/go2rtc" "$(unit_path)" 2>/dev/null
  fi
}

existing_api_value() {
  [ -f "$CONFIG" ] || return 1
  value=$(yaml_value "$1")
  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

existing_server_value() {
  if [ -f "$BUNDLE_DIR/cameras.ini" ]; then
    value=$(awk -v want="$1" '
      /^[ \t]*\[server\][ \t]*$/ { in_server = 1; next }
      /^[ \t]*\[/ { in_server = 0 }
      in_server {
        line = $0; sub(/^[ \t]+/, "", line)
        eq = index(line, "="); if (eq == 0) next
        key = substr(line, 1, eq - 1); sub(/[ \t]+$/, "", key)
        if (key == want) { v = substr(line, eq + 1); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }
      }' "$BUNDLE_DIR/cameras.ini")
    [ -n "$value" ] && { printf '%s' "$value"; return 0; }
  fi
  existing_api_value "$1"
}

sync_routes() {
  www="$BUNDLE_DIR/www"
  [ -d "$www" ] && [ -f "$www/index.html" ] || return 0
  marker="$www/.routes"

  wanted=$(sed -n 's/.*"route": "\([^"]*\)".*/\1/p' "$BUNDLE_DIR/cameras.json" 2>/dev/null)

  if [ -f "$marker" ]; then
    while IFS= read -r stale; do
      [ -n "$stale" ] || continue
      printf '%s\n' "$wanted" | grep -qx "$stale" && continue
      [ -f "$www/$stale/index.html" ] && rm -rf "$www/$stale"
    done < "$marker"
    rm -f "$marker"
  fi

  count=0
  for route in $wanted; do
    [ -n "$route" ] || continue
    mkdir -p "$www/$route"
    cp "$www/index.html" "$www/$route/index.html"
    printf '%s\n' "$route" >> "$marker"
    count=$((count + 1))
  done
  [ "$count" -gt 0 ] && echo "Routes: $(printf '/%s ' $wanted)"
  return 0
}

render_config() {
  [ -f "$BUNDLE_DIR/cameras.ini" ] || die "no cameras.ini in $BUNDLE_DIR"
  [ -f "$BUNDLE_DIR/scripts/config.awk" ] || die "this bundle ships no config.awk. Install a newer release."
  LC_ALL=C awk -v out="$BUNDLE_DIR" -v static_dir=www -f "$BUNDLE_DIR/scripts/config.awk" "$BUNDLE_DIR/cameras.ini" \
    || die "cameras.ini has problems. Fix them and run this again."
  if [ -d "$BUNDLE_DIR/www" ]; then cp "$BUNDLE_DIR/cameras.json" "$BUNDLE_DIR/www/cameras.json"; fi
  sync_routes
  return 0
}

discover_with_go2rtc() {
  target=$1
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  [ -x "$BUNDLE_DIR/go2rtc" ] || die "no go2rtc binary in $BUNDLE_DIR"
  [ -n "${ONVIF_USER:-}" ] && [ -n "${ONVIF_PASSWORD:-}" ] ||
    die "set ONVIF_USER and ONVIF_PASSWORD to the camera account, then run this again"

  scratch=$(mktemp -d)
  port=$((19000 + $$ % 900))
  printf 'api:\n  listen: 127.0.0.1:%s\nrtsp:\n  listen: ""\nwebrtc:\n  listen: ""\n' "$port" \
    > "$scratch/probe.yaml"
  ( cd "$scratch" && "$BUNDLE_DIR/go2rtc" -config "$scratch/probe.yaml" > "$scratch/probe.log" 2>&1 & )

  ready=no
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    if curl -fsS -m 2 -o /dev/null "http://127.0.0.1:$port/api" 2>/dev/null; then ready=yes; break; fi
    attempt=$((attempt + 1))
    sleep 0.2
  done
  if [ "$ready" != yes ]; then
    pkill -f "go2rtc -config $scratch/probe.yaml" 2>/dev/null || true
    rm -rf "$scratch"
    die "could not start go2rtc for the scan"
  fi

  echo "Scanning the network for ONVIF cameras..."
  : > "$scratch/devices"
  for pass in 1 2; do
    json=$(curl -fsS -m 20 "http://127.0.0.1:$port/api/onvif" 2>/dev/null) || json=""
    [ -n "$json" ] || continue
    json_objects "$json" | while IFS= read -r object; do
      [ -n "$object" ] || continue
      device=$(json_field name "$object")
      info=$(json_field info "$object")
      [ -n "$device" ] && printf '%s|%s\n' "$device" "$info" >> "$scratch/devices"
    done
  done
  sort -u "$scratch/devices" -o "$scratch/devices"

  user=$(urlencode "$ONVIF_USER")
  password=$(urlencode "$ONVIF_PASSWORD")
  : > "$scratch/cameras"
  : > "$scratch/names"
  found=0

  while IFS='|' read -r device info; do
    [ -n "$device" ] || continue
    source_url="onvif://$user:$password@$device"
    profiles=$(curl -fsS -m 25 -G "http://127.0.0.1:$port/api/onvif" \
      --data-urlencode "src=$source_url" 2>/dev/null) || profiles=""
    urls=$(printf '%s' "$profiles" | grep -o '"url":"[^"]*"' | sed 's/"url":"//; s/"$//')
    main=$(printf '%s\n' "$urls" | sed -n 1p)
    sub=$(printf '%s\n' "$urls" | sed -n 2p)
    if [ -z "$main" ]; then
      echo "  ${device%%:*}: no stream profile. It may reject the account." >&2
      continue
    fi

    label=$(printf '%s' "$info" | awk '{for (i = 1; i <= NF; i++) if (!seen[$i]++) printf "%s%s", (i > 1 && out ? " " : ""), $i, out = 1}')
    [ -n "$label" ] || label=${device%%:*}
    base=$(slugify "$(printf '%s' "$label" | awk '{print $1}')")
    [ -n "$base" ] || base=$(slugify "cam_${device%%:*}")
    name=$base
    suffix=$(printf '%s' "${device%%:*}" | awk -F. '{print $4}')
    if grep -qx "$name" "$scratch/names" 2>/dev/null; then name="${base}_${suffix}"; fi
    counter=2
    while grep -qx "$name" "$scratch/names" 2>/dev/null; do
      name="${base}_${suffix}_$counter"
      counter=$((counter + 1))
    done
    printf '%s\n' "$name" >> "$scratch/names"

    main_profile=$(printf '%s' "$main" | sed -n 's/.*subtype=//p')
    sub_profile=$(printf '%s' "$sub" | sed -n 's/.*subtype=//p')
    {
      echo ""
      echo "[$name]"
      echo "label = $label"
      echo "host = ${device%%:*}"
      echo "username = $ONVIF_USER"
      echo "password = $ONVIF_PASSWORD"
      echo "onvif.port = ${device##*:}"
      if [ -n "$main_profile" ]; then echo "onvif.profile = $main_profile"; fi
      if [ -n "$sub_profile" ] && [ "$sub_profile" != "$main_profile" ]; then echo "onvif.sub_profile = $sub_profile"; fi
    } >> "$scratch/cameras"
    echo "  ${device%%:*}  $name  $(printf '%s\n' "$urls" | grep -c .) profile(s)"
    found=$((found + 1))
  done < "$scratch/devices"

  pkill -f "go2rtc -config $scratch/probe.yaml" 2>/dev/null || true

  if [ "$found" -eq 0 ]; then
    rm -rf "$scratch"
    die "found no ONVIF camera. Try: ipcam discover --deep"
  fi

  listen=$(existing_server_value listen || printf ':80')
  viewer=$(existing_server_value username || printf 'viewer')
  secret=$(existing_server_value password || random_secret)
  {
    echo "[server]"
    echo "listen = $listen"
    echo "username = $viewer"
    echo "password = $secret"
    cat "$scratch/cameras"
  } > "$target"
  rm -rf "$scratch"

  echo "Found $found camera(s)."
  echo "Viewer login: $viewer / $secret"
}

discover_with_node() {
  target=$1
  shift
  command -v node >/dev/null 2>&1 || die "node is not installed. Drop --deep to scan with go2rtc."
  script="$BUNDLE_DIR/scripts/discover-cameras.mjs"
  [ -f "$script" ] || die "this bundle ships no discovery script. Install a newer release."
  rm -f "$target"
  if [ -f "$BUNDLE_DIR/cameras.ini" ]; then
    node "$script" --write-config "$target" --keep-server "$BUNDLE_DIR/cameras.ini" "$@" ||
      die "the scan failed"
  else
    node "$script" --write-config "$target" "$@" || die "the scan failed"
  fi
}

cmd_discover() {
  deep=no
  replace=no
  apply=no
  rest=""
  for argument in "$@"; do
    case $argument in
      --deep) deep=yes ;;
      --replace|--force) replace=yes ;;
      --apply) apply=yes ;;
      *) rest="$rest $argument" ;;
    esac
  done

  merger="$BUNDLE_DIR/scripts/merge-ini.awk"
  candidate=$(mktemp) || die "could not write a temporary file"

  if [ "$deep" = yes ]; then
    # shellcheck disable=SC2086
    discover_with_node "$candidate" $rest
  else
    discover_with_go2rtc "$candidate"
  fi
  [ -s "$candidate" ] || { rm -f "$candidate"; die "the scan wrote nothing"; }

  if [ -f "$BUNDLE_DIR/cameras.ini" ] && [ "$replace" != yes ]; then
    [ -f "$merger" ] || { rm -f "$candidate"; die "this bundle ships no merge-ini.awk. Install a newer release."; }
    merged=$(mktemp) || die "could not write a temporary file"
    LC_ALL=C awk -f "$merger" "$BUNDLE_DIR/cameras.ini" "$candidate" > "$merged" ||
      { rm -f "$candidate" "$merged"; die "the merge failed"; }
    mv "$merged" "$BUNDLE_DIR/cameras.ini"
    echo "Updated $BUNDLE_DIR/cameras.ini"
  else
    mv "$candidate" "$BUNDLE_DIR/cameras.ini"
    echo "Wrote $BUNDLE_DIR/cameras.ini"
  fi
  rm -f "$candidate"

  if [ "$apply" != yes ]; then
    echo ""
    echo "It changed no running config. Review the file, rename the cameras, then:"
    echo "  ipcam update"
    return 0
  fi

  render_config
  echo "Config regenerated from $BUNDLE_DIR/cameras.ini"
  if service_is_this_bundle; then
    cmd_restart
  else
    echo "Next: ipcam install"
  fi
}

cmd_upgrade() {
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  url="https://raw.githubusercontent.com/isdaniarf/ipcam-viewer/main/install.sh"
  echo "Fetching the installer from $url"
  IPCAM_PREFIX="$BUNDLE_DIR" IPCAM_KEEP_CONFIG=1 sh -c "curl -fsSL '$url' | sh" || die "the upgrade failed"
}

cmd_version() {
  app=$(build_info version || printf 'dev')
  commit=$(build_info commit || printf '')
  if [ -n "$commit" ]; then
    echo "ipcam-viewer $app ($commit)"
  else
    echo "ipcam-viewer $app"
  fi
  echo "bundle:   $BUNDLE_DIR"
  echo "platform: $(build_info platform || echo unknown)"
  echo "built:    $(build_info built || echo unknown)"
  "$BUNDLE_DIR/go2rtc" --version 2>/dev/null || true
}

cmd_help() {
  cat <<'EOF'
Usage: ipcam <command> [options]

  install [--no-link]  Install the service, start it, and link the command into PATH
  uninstall            Stop the service, remove it, and remove the link
  start                Start the service
  stop                 Stop the service
  restart              Restart the service
  status               Show the service state, the URL and the link
  logs                 Follow the service log
  url                  Print the address and the viewer user name
  update [--build]     Regenerate the config from cameras.ini, then restart.
                       --build also rebuilds the page. It needs the repository.
  discover [options]   Scan for ONVIF cameras and update cameras.ini. It keeps every
                       camera already in the file, matching on host, and appends the
                       ones it finds that are missing. It leaves the running config
                       alone; run "ipcam update" to apply it.
                         --apply    regenerate the config and restart at once
                         --replace  write a fresh file instead of merging
                         --deep     use the bundled scanner instead. It needs Node.js,
                                    and it also finds cameras that speak no ONVIF.
                       Set ONVIF_USER and ONVIF_PASSWORD first.
  config <action>      show, export <file.tgz>, or
                       import <file.tgz|cameras.ini|go2rtc.yaml|url>
  upgrade              Install the newest release, and keep the config
  link                 Link this command into PATH
  unlink               Remove the link
  version              Show the app, bundle and go2rtc versions
  help                 Show this text

The link goes to ~/.local/bin by default. Set IPCAM_BIN_DIR to change it.
EOF
}

command_name=${1:-help}
[ $# -gt 0 ] && shift || true

case $command_name in
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  logs) "logs_$OS" ;;
  url) cmd_url ;;
  update) cmd_update "$@" ;;
  discover) cmd_discover "$@" ;;
  config) cmd_config "$@" ;;
  upgrade) cmd_upgrade ;;
  link) do_link ;;
  unlink) do_unlink ;;
  version|--version|-v) cmd_version ;;
  help|-h|--help) cmd_help ;;
  *) echo "ipcam: unknown command \"$command_name\"" >&2; cmd_help >&2; exit 1 ;;
esac
